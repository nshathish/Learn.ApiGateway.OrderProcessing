{
  "Urls": "http://0.0.0.0:8080",
  "ServiceUrls": {
    "ProductService": "http://productservice:8080",
    "CartService": "http://cartservice:8080",
    "UserService": "http://userservice:8080",
    "PaymentService": "http://paymentservice:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/products/{**catch-all}" }
        ]
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "product-cluster": {
        "Destinations": {
          "product1": {
            "Address": "http://productservice:8080/"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart1": {
            "Address": "http://cartservice:8080/"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user1": {
            "Address": "http://userservice:8080/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment1": {
            "Address": "http://paymentservice:8080/"
          }
        }
      }
    }
  }
}
